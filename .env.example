# ===================================================================
# SMART VEHICLE SAFETY - BACKEND CONFIGURATION (.env)
# ===================================================================
#
# Free Email Notifications via Gmail SMTP
# IMPORTANT:
# - NEVER commit your actual .env file or credentials to Git.
# - Do NOT use your primary Google account password here!
# - Google requires an "App Password" (16 characters) generated under:
#   Google Account -> Security -> 2-Step Verification -> App Passwords.
# ===================================================================

# Server Port
PORT=3001

# Gmail SMTP Server Settings (Free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Authorized Sender Gmail Account
SMTP_USER=your-email@gmail.com

# Gmail 16-Character App Password (Generated from Google Account Security)
SMTP_PASS=abcd-efgh-ijkl-mnop

# Default Authorized Emergency Recipient Email Address
ALERT_RECIPIENT_EMAIL=emergency-contact@example.com

# Mock Email Mode (true = logs & simulates SMTP acceptance without sending real emails; false = live Gmail SMTP)
# Set to 'true' if you want to test the full end-to-end pipeline without configuring Gmail credentials.
MOCK_EMAIL=true
